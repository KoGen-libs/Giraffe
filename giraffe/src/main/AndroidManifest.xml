<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <activity
            android:name=".ui.common.main.GiraffeActivity"
            android:excludeFromRecents="false"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.kogen.giraffe.task"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!--
        Authority is namespaced with ${applicationId} so it can't collide with a FileProvider
        the host app declares for itself - Giraffe is embedded into arbitrary host apps, and two
        providers sharing one authority would fail the manifest merge. android:name also uses a
        distinct subclass (GiraffeFileProvider), not the raw FileProvider class - the merger keys
        <provider> elements by android:name, so reusing FileProvider directly still collides with
        a host app's own FileProvider declaration even with differing authorities.
        -->
        <provider
            android:name="com.kogen.giraffe.provider.GiraffeFileProvider"
            android:authorities="${applicationId}.giraffeprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/giraffe_file_paths" />
        </provider>
    </application>
</manifest>